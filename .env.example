DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
APP_PORT=8766
BROWSER=edge
INPUT_MODE=existing_browser
SCREENSHOT_EVIDENCE=false
MAX_ELEMENTS=180
CANDIDATES_PER_CATEGORY=3
ACTION_DELAY=0.6
MAX_STEPS=400
MAX_MODEL_CALLS=240
MAX_RUN_SECONDS=3600
MAX_NO_PROGRESS=5
# 方案选择倒计时（秒）；超时采用推荐方案，不会直接进入结算或付款
CHOICE_TIMEOUT_SECONDS=10
# recommend_only：超时只采用推荐方案；low_risk_auto：严格核验后自动加购
CHOICE_POLICY=recommend_only
API_TIMEOUT=90
MAX_OUTPUT_TOKENS=4096

# 每任务累计输入 token 上限；达到后保留结果并暂停
MAX_INPUT_TOKENS=2000000

# 本地 Qwen 3B：筛选候选，不产生 DeepSeek 费用
QWEN_MODEL=qwen2.5:3b
QWEN_BASE_URL=http://127.0.0.1:11434
# 默认保存在项目 data/ollama-models；可改到任意本机目录
OLLAMA_MODELS=
MAX_LOCAL_CALLS=80
MAX_LOCAL_INPUT_CHARS=8000
